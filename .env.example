# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_or_channel_id_here

# Facebook Auth Storage Path
STORAGE_STATE_PATH=cookies/fb-auth.json

# SQLite Database Path
DB_PATH=db/database.sqlite

# Polling Interval (in seconds)
# Formula: BaseInterval + Random(JitterMin, JitterMax)
POLL_BASE_INTERVAL_SEC=90
POLL_JITTER_MIN_SEC=10
POLL_JITTER_MAX_SEC=40

# Crawler Settings
HEADLESS=true
MAX_POSTS_PER_GROUP=5
SCAN_COMMENTS=true
DELAY_BETWEEN_GROUPS_MIN_MS=4000
DELAY_BETWEEN_GROUPS_MAX_MS=7000

# Facebook Groups (JSON array or comma-separated URLs)
# E.g.: FB_GROUP_URLS=https://www.facebook.com/groups/123456?sorting_setting=CHRONOLOGICAL,https://www.facebook.com/groups/789012?sorting_setting=CHRONOLOGICAL
FB_GROUP_URLS=

# Gemini AI Filter (Tự động nhận diện bài viết pass vé, tránh bỏ sót thông tin)
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ENABLE_GEMINI=true
GEMINI_MODE=smart
